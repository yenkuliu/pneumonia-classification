{
  "num_classes": 2,
  "seed": 820,
  "image_size": 256,
  "resize_size": 256,
  "batch_size": 16,
  "num_workers": 2,
  "epochs": 20,
  "early_stopping_patience": 5,
  "learning_rate": 0.00001,
  "weight_decay": 0.0005,
  "internal_validation_fraction": 0.2,
  "selection_metric": "balanced_accuracy",
  "loss_type": "cross_entropy",
  "label_smoothing": 0.0,
  "class_weight_strategy": "manual",
  "manual_class_weights": {"NORMAL": 1.5, "PNEUMONIA": 1.0},
  "sampler_strategy": "none",
  "augmentation": {
    "horizontal_flip_p": 0.5,
    "rotation_degrees": 10,
    "color_jitter_brightness": 0.12,
    "color_jitter_contrast": 0.12
  },
  "tuning_scope": "all",
  "preprocessing": "full_frame",
  "contrast": "none",
  "head_learning_rate": 0.0005,
  "dropout": 0.25,
  "freeze_batchnorm": true,
  "warmup_epochs": 2,
  "split_policy": "filename_groups_v1",
  "split_seed": 820,
  "deterministic": true,
  "validation_only": true,
  "require_cuda": true
}
